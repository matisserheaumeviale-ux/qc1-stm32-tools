{
  "name": "qc1-stm32-tools",
  "displayName": "QC1 STM32F103 CMake Tools",
  "description": "Extension STM32F103 autonome avec moteur de build CMake intégré",
  "version": "0.3.1",
  "publisher": "Mistral400",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/matisserheaumeviale-ux/qc1-stm32-tools.git"
  },
  "files": [
    "out/**",
    "media/**",
    "resources/cmake/**",
    "examples/**",
    "QC1_CODES.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "engines": {
    "vscode": "^1.118.0"
  },
  "extensionDependencies": [
    "ms-vscode.cmake-tools",
    "mylonics.embedded-build-tools"
  ],
  "activationEvents": [
    "onView:qc1.panel",
    "onView:liixAiChat",
    "workspaceContains:CMakeLists.txt",
    "workspaceContains:**/*.ioc",
    "workspaceContains:**/*.eww",
    "workspaceContains:**/*.ewp",
    "onCommand:qc1.build",
    "onCommand:qc1.flash",
    "onCommand:qc1.run",
    "onCommand:qc1.status",
    "onCommand:qc1.createDiagnosticReport"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "qc1",
          "title": "QC1 STM32",
          "icon": "media/icon.svg"
        },
        {
          "id": "liix-ai",
          "title": "Liix AI",
          "icon": "media/liix-ai.svg"
        }
      ]
    },
    "views": {
      "qc1": [
        {
          "id": "qc1.panel",
          "name": "STM32 Tools",
          "type": "webview"
        }
      ],
      "liix-ai": [
        {
          "id": "liixAiChat",
          "name": "Liix AI",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "qc1.build",
        "title": "Build Project",
        "category": "QC1 STM32",
        "icon": "$(tools)"
      },
      {
        "command": "qc1.clean",
        "title": "Clean Project",
        "category": "QC1 STM32",
        "icon": "$(trash)"
      },
      {
        "command": "qc1.rebuild",
        "title": "Rebuild Project",
        "category": "QC1 STM32",
        "icon": "$(sync)"
      },
      {
        "command": "qc1.tsmake",
        "title": "QC1: Test Build"
      },
      {
        "command": "qc1.flash",
        "title": "Flash STM32",
        "category": "QC1 STM32",
        "icon": "$(debug-start)"
      },
      {
        "command": "qc1.run",
        "title": "Build + Flash + Status",
        "category": "QC1 STM32",
        "icon": "$(play)"
      },
      {
        "command": "qc1.health",
        "title": "QC1: Health Check"
      },
      {
        "command": "qc1.status",
        "title": "Show STM32 Status",
        "category": "QC1 STM32",
        "icon": "$(pulse)"
      },
      {
        "command": "qc1.error",
        "title": "QC1: Errors"
      },
      {
        "command": "qc1.detectStlink",
        "title": "Detect ST-Link",
        "category": "QC1 STM32",
        "icon": "$(search)"
      },
      {
        "command": "qc1.openSerial",
        "title": "Open Serial Monitor",
        "category": "QC1 STM32",
        "icon": "$(plug)"
      },
      {
        "command": "qc1.startOpenOcd",
        "title": "Start OpenOCD",
        "category": "QC1 STM32",
        "icon": "$(radio-tower)"
      },
      {
        "command": "qc1.configure",
        "title": "Configure QC1 STM32 Tools",
        "category": "QC1 STM32",
        "icon": "$(settings-gear)"
      },
      {
        "command": "qc1.createDiagnosticReport",
        "title": "Créer un rapport de diagnostic",
        "category": "QC1 STM32",
        "icon": "$(report)"
      },
      {
        "command": "qc1.refresh",
        "title": "Refresh QC1 Panel",
        "category": "QC1 STM32",
        "icon": "$(refresh)"
      },
      {
        "command": "qc1.dev",
        "title": "QC1: Dev Mode"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "qc1.build"
        },
        {
          "command": "qc1.clean"
        },
        {
          "command": "qc1.rebuild"
        },
        {
          "command": "qc1.flash"
        },
        {
          "command": "qc1.run"
        },
        {
          "command": "qc1.status"
        },
        {
          "command": "qc1.detectStlink"
        },
        {
          "command": "qc1.openSerial"
        },
        {
          "command": "qc1.startOpenOcd"
        },
        {
          "command": "qc1.configure"
        },
        {
          "command": "qc1.createDiagnosticReport"
        }
      ],
      "view/title": [
        {
          "command": "qc1.refresh",
          "when": "view == qc1.panel",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "qc1.build",
          "when": "view == qc1.panel",
          "group": "inline"
        },
        {
          "command": "qc1.flash",
          "when": "view == qc1.panel",
          "group": "inline"
        }
      ]
    },
    "configuration": [
      {
        "title": "QC1 STM32 Tools",
        "properties": {
          "qc1.projectPath": {
            "type": "string",
            "default": "",
            "description": "Chemin du dossier projet STM32. Vide = auto-détection depuis le workspace."
          },
          "qc1.cmakePath": {
            "type": "string",
            "default": "",
            "description": "Chemin vers l'exécutable CMake. Vide = auto-détection dans le PATH ou via CMake Tools."
          },
          "qc1.buildDirectory": {
            "type": "string",
            "default": "build/qc1",
            "description": "Dossier de build CMake relatif au projet STM32."
          },
          "qc1.buildType": {
            "type": "string",
            "enum": [
              "Debug",
              "Release",
              "RelWithDebInfo",
              "MinSizeRel"
            ],
            "default": "Debug",
            "description": "Configuration CMake utilisée par QC1."
          },
          "qc1.compilerPath": {
            "type": "string",
            "default": "",
            "description": "Chemin vers arm-none-eabi-gcc. Vide = auto-détection dans le PATH."
          },
          "qc1.openocdPath": {
            "type": "string",
            "default": "",
            "description": "Chemin vers openocd. Vide = auto-détection dans le PATH."
          },
          "qc1.serialPort": {
            "type": "string",
            "default": "",
            "description": "Serial port used for STM32 UART"
          },
          "qc1.baudRate": {
            "type": "number",
            "default": 19200,
            "description": "UART baud rate"
          },
          "qc1.stlinkPath": {
            "type": "string",
            "default": "st-info",
            "description": "Path to ST-Link command line tool"
          },
          "qc1.autoDetectProject": {
            "type": "boolean",
            "default": true,
            "description": "Automatically detect STM32 project files"
          },
          "qc1.autoClearOutput": {
            "type": "boolean",
            "default": false,
            "description": "Clear output before running"
          },
          "qc1.showTimestamps": {
            "type": "boolean",
            "default": true,
            "description": "Show timestamps in output"
          },
          "qc1.outputMaxLines": {
            "type": "number",
            "default": 500,
            "minimum": 50,
            "maximum": 5000,
            "description": "Max output lines"
          },
          "qc1.compactMode": {
            "type": "boolean",
            "default": false,
            "description": "Compact UI mode"
          },
          "qc1.autoRefreshStatus": {
            "type": "boolean",
            "default": true,
            "description": "Auto refresh status"
          },
          "qc1.enablePointerVisualizer": {
            "type": "boolean",
            "default": true,
            "description": "Enable pointer visualizer"
          },
          "qc1.pointerVisualizerMaxDepth": {
            "type": "number",
            "default": 3,
            "minimum": 1,
            "maximum": 10,
            "description": "Pointer depth"
          },
          "qc1.visualizerTheme": {
            "type": "string",
            "enum": [
              "auto",
              "dark",
              "light"
            ],
            "default": "auto",
            "description": "Visualizer theme"
          }
        }
      },
      {
        "title": "Liix AI",
        "properties": {
          "liix.provider": {
            "type": "string",
            "default": "liix",
            "enum": [
              "liix",
              "local"
            ],
            "description": "AI provider to use: Liix cloud API or local model server"
          },
          "liix.apiUrl": {
            "type": "string",
            "default": "https://true-mega-shall-icq.trycloudflare.com",
            "description": "Liix API URL"
          },
          "liix.apiKey": {
            "type": "string",
            "default": "",
            "description": "Liix API Key"
          },
          "liix.localApiUrl": {
            "type": "string",
            "default": "http://localhost:11434",
            "description": "Local AI server URL. Example: Ollama http://localhost:11434 or LM Studio http://localhost:1234"
          },
          "liix.localApiType": {
            "type": "string",
            "default": "ollama",
            "enum": [
              "ollama",
              "openai-compatible"
            ],
            "description": "Local AI server API type"
          },
          "liix.localModel": {
            "type": "string",
            "default": "qwen2.5-coder:7b-instruct",
            "description": "Local model name to use"
          },
          "liix.defaultModel": {
            "type": "string",
            "default": "liix-code-0.1",
            "description": "Default Liix model selected in the webview"
          },
          "liix.userName": {
            "type": "string",
            "default": "Utilisateur Liix",
            "description": "Display name used in the Liix Account page"
          },
          "liix.accountEmail": {
            "type": "string",
            "default": "",
            "description": "Optional account email/provider label shown in the Liix Account page"
          },
          "liix.language": {
            "type": "string",
            "default": "fr",
            "enum": [
              "fr",
              "en"
            ],
            "description": "Liix UI language"
          },
          "liix.uiAnimations": {
            "type": "boolean",
            "default": true,
            "description": "Enable lightweight Liix UI animations"
          },
          "liix.telemetry": {
            "type": "boolean",
            "default": false,
            "description": "Enable Liix telemetry"
          },
          "liix.agentMode": {
            "type": "string",
            "default": "chat",
            "enum": [
              "chat",
              "agent",
              "full"
            ],
            "description": "Default Liix agent mode"
          },
          "liix.aiTimeoutMs": {
            "type": "number",
            "default": 120000,
            "minimum": 5000,
            "maximum": 600000,
            "description": "AI request and tool execution timeout"
          },
          "liix.maxTokens": {
            "type": "number",
            "default": 4096,
            "minimum": 256,
            "maximum": 131072,
            "description": "Maximum response tokens target"
          },
          "liix.temperature": {
            "type": "number",
            "default": 0.2,
            "minimum": 0,
            "maximum": 2,
            "description": "Default model temperature"
          },
          "liix.permissions.terminal": {
            "type": "string",
            "default": "ask",
            "enum": [
              "none",
              "ask",
              "allow"
            ],
            "description": "Terminal command permission policy"
          },
          "liix.permissions.files": {
            "type": "string",
            "default": "ask",
            "enum": [
              "none",
              "ask",
              "allow"
            ],
            "description": "File write permission policy"
          },
          "liix.permissions.git": {
            "type": "string",
            "default": "ask",
            "enum": [
              "read",
              "ask",
              "allow"
            ],
            "description": "Git command permission policy"
          }
        }
      }
    ]
  },
  "scripts": {
    "compile": "node ./node_modules/typescript/bin/tsc",
    "test": "npm run compile && node --test test/*.test.js",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.118.0",
    "@vscode/vsce": "^3.9.1",
    "typescript": "^5.0.0"
  }
}
